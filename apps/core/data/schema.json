  },
  "updated_at": {
   "type": "string",
   "required": true,
   "format": "YYYY-MM-DD"
  },
  "status": {
   "type": "string",
   "required": true,
   "enum_ref": "status"
  },
  "overrides": {
   "type": "object",
   "required": false,
