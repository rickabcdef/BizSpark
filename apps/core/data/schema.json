  },
  "pitfalls": {
   "type": "array[string]",
   "required": true,
   "exact_items": 3
  },
  "compliance_note": {
   "type": "string",
   "required": true,
   "max_len": 140,
   "rule": "仅一句提醒，不是法律意见"
  },
  "wave": {
   "type": "string",
   "required": true,
   "enum_ref": "wave"
  },
  "trend_tags": {
   "type": "array[string]",
   "required": true,
   "max_items": 5
  },
  "first_seen": {
   "type": "string",
   "required": true,
